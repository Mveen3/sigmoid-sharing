[Unit]
Description=Sigmoid Sharing Local File Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/mveen/Documents/sigmoid-sharing
ExecStart=/usr/bin/node /home/mveen/Documents/sigmoid-sharing/src/server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=8080

[Install]
WantedBy=default.target
